# ---- Server ----
PORT=3000
# Keep 127.0.0.1 unless you protect the app with APP_PASSWORD.
HOST=127.0.0.1
# Required when HOST is not 127.0.0.1 (Basic auth; any username).
APP_PASSWORD=

# ---- Market data ----
# demo    = simulated data (no keys, for learning the screen)
# polygon = real data from Polygon.io (real-time needs a plan with real-time stocks + quotes)
DATA_PROVIDER=demo
POLYGON_API_KEY=

# ---- Broker ----
# demo   = simulated fills inside the app
# alpaca = Alpaca (PAPER by default)
BROKER=demo
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# Set to true ONLY when you want real-money orders.
ALPACA_LIVE=false
